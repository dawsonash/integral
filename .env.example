# Copy to .env (systemd reads it via EnvironmentFile). Everything is optional
# in local dev: with nothing set you get dev login, no billing, console email.

# ---- core ----
PORT=4000
# Where the SQLite db, artifacts, and event logs live (default: ./data)
#INTEGRAL_DATA_DIR=/opt/integral/data
# Public URL of the dashboard origin (OAuth callbacks, Stripe redirects, emails)
#INTEGRAL_APP_URL=https://app.integral.example.com
# Hostname of the artifact/take origin. Setting this activates the origin
# split: hosted artifacts can never touch dashboard cookies.
#INTEGRAL_RUN_HOST=run.integral.example.com
# Set when running behind a reverse proxy (Caddy) so client IPs are right.
#INTEGRAL_TRUST_PROXY=1
# Session-cookie signing secret; auto-generated into the data dir if unset.
#INTEGRAL_SESSION_SECRET=

# ---- auth (GitHub OAuth app; callback = $INTEGRAL_APP_URL/auth/github/callback) ----
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# ---- billing (Stripe) ----
#STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret for $INTEGRAL_APP_URL/webhooks/stripe
#STRIPE_WEBHOOK_SECRET=whsec_...
#
# Price ids, one per plan × billing period. Yearly is exactly 10% off.
#   Individual  $20/mo   $216/yr
#   Team base   $20/mo   $216/yr   (workspace + the owner's seat)
#   Team seat   $10/mo   $108/yr   (per teammate beyond the owner; quantity is
#                                   synced from the roster by lib/teams.js)
# The landing page and dashboard hardcode these numbers — keep them in step
# (see docs/go-to-market.md).
#STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
#STRIPE_PRICE_INDIVIDUAL_YEARLY=price_...
#STRIPE_PRICE_TEAM_MONTHLY=price_...
#STRIPE_PRICE_TEAM_YEARLY=price_...
#STRIPE_PRICE_TEAM_SEAT_MONTHLY=price_...
#STRIPE_PRICE_TEAM_SEAT_YEARLY=price_...
# Legacy single-price installs: still honoured as the individual monthly price
# when STRIPE_PRICE_INDIVIDUAL_MONTHLY is unset.
#STRIPE_PRICE_ID=price_...

# ---- email (Resend; unset = notifications logged to console) ----
#RESEND_API_KEY=re_...
#EMAIL_FROM=Integral <notify@integral.example.com>
# Where abuse reports get mailed
#INTEGRAL_ABUSE_EMAIL=you@example.com

# ---- tuning ----
#INTEGRAL_MIN_DURATION_MS=3000

# ---- fake-backend sandbox (server-rendered tests; prototype, trusted repos only) ----
# Admin connection used to provision throwaway per-test databases. The
# sandbox creates/drops databases named integral_sbx_<testid> on this server.
#INTEGRAL_SANDBOX_PG_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Max concurrently running sandboxed apps (default 2).
#INTEGRAL_SANDBOX_MAX=2
# Idle teardown: kill the app + drop its DB after this long with no traffic.
#INTEGRAL_SANDBOX_IDLE_MS=900000
