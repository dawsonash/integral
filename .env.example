# Copy to .env (systemd reads it via EnvironmentFile). Everything is optional
# in local dev: with nothing set you get dev login, no billing, console email.

# ---- core ----
PORT=4000
# Where the SQLite db, artifacts, and event logs live (default: ./data)
#INTEGRAL_DATA_DIR=/opt/integral/data
# Public URL of the dashboard origin (OAuth callbacks, Stripe redirects, emails)
#INTEGRAL_APP_URL=https://app.integral.example.com
# Hostname of the artifact/take origin. Setting this activates the origin
# split: hosted artifacts can never touch dashboard cookies.
#INTEGRAL_RUN_HOST=run.integral.example.com
# Set when running behind a reverse proxy (Caddy) so client IPs are right.
#INTEGRAL_TRUST_PROXY=1
# Bind address for the Node listener (default: every interface). Set 127.0.0.2
# when the fake-backend sandbox is enabled: the sandbox's cgroup address filter
# permits 127.0.0.1 — its throwaway Postgres and the stub proxy — and nothing
# else, so keeping this API off 127.0.0.1 is what denies a sandboxed app any
# route to it (including spoofing X-Forwarded-For past rate limiting). Must
# match the reverse_proxy upstream in deploy/Caddyfile.
#INTEGRAL_BIND_HOST=127.0.0.2
# Session-cookie signing secret; auto-generated into the data dir if unset.
#INTEGRAL_SESSION_SECRET=

# ---- auth (GitHub OAuth app; callback = $INTEGRAL_APP_URL/auth/github/callback) ----
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# ---- billing (Stripe) ----
#STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret for $INTEGRAL_APP_URL/webhooks/stripe
#STRIPE_WEBHOOK_SECRET=whsec_...
#
# Price ids, one per plan × billing period. Yearly is exactly 10% off.
#   Individual  $20/mo   $216/yr
#   Team base   $20/mo   $216/yr   (workspace + the owner's seat)
#   Team seat   $10/mo   $108/yr   (per teammate beyond the owner; quantity is
#                                   synced from the roster by lib/teams.js)
# The landing page and dashboard hardcode these numbers — keep them in step
# (see docs/go-to-market.md).
#STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
#STRIPE_PRICE_INDIVIDUAL_YEARLY=price_...
#STRIPE_PRICE_TEAM_MONTHLY=price_...
#STRIPE_PRICE_TEAM_YEARLY=price_...
#STRIPE_PRICE_TEAM_SEAT_MONTHLY=price_...
#STRIPE_PRICE_TEAM_SEAT_YEARLY=price_...
# Legacy single-price installs: still honoured as the individual monthly price
# when STRIPE_PRICE_INDIVIDUAL_MONTHLY is unset.
#STRIPE_PRICE_ID=price_...

# ---- email (Resend; unset = notifications logged to console) ----
#RESEND_API_KEY=re_...
#EMAIL_FROM=Integral <notify@integral.example.com>
# Where abuse reports get mailed
#INTEGRAL_ABUSE_EMAIL=you@example.com

# ---- tuning ----
#INTEGRAL_MIN_DURATION_MS=3000

# ---- fake-backend sandbox (server-rendered tests; prototype, trusted repos only) ----
# Booting a sandbox runs the repo's own start/schema/seed commands as a child
# process on this host — remote code execution by design (docs/fake-backend-spec.md
# §9). INTEGRAL_SANDBOX_CONFINE below puts that process behind a separate uid and
# a cgroup, but it is still the same kernel, so this stays an allowlist feature:
# in production it is off unless the test owner's GitHub login is listed here,
# comma-separated.
# '*' enables it for every user of this deployment: single-tenant installs
# only, since it hands each of them a shell. Unset in production = off for
# everyone, which is the intended launch posture; static, SPA, and React
# artifacts are unaffected. Outside production it is on by default so local
# development and the test suite work with no configuration.
#INTEGRAL_SANDBOX_ALLOW=yourlogin
#
# How the sandboxed process is confined (server/lib/sandbox/confine.js):
#   auto     (default) confine when deploy/integral-sandbox-run is installed.
#            In production a missing wrapper is a hard error — a sandbox that
#            cannot be confined refuses to boot rather than running the repo's
#            code as the Integral service user. Outside production it warns and
#            runs unconfined, so local dev and the test suite need no setup.
#   require  treat a missing wrapper as an error everywhere. Use this to check
#            production behaviour locally.
#   off      never confine. Local development only.
# Confined means: dropped to the unprivileged integral-sbx uid inside a systemd
# scope with memory/CPU/task/wall-clock caps and cgroup-level egress filtering
# (which, unlike the stub proxy, applies to clients that ignore proxy env vars).
# deploy/README.md has the one-time host setup; it is required for the uid split
# to mean anything, and preflight refuses to start if .env or integral.db are
# still readable by the sandbox user.
#INTEGRAL_SANDBOX_CONFINE=auto
#
# Admin connection used to provision throwaway per-test databases. Needs
# CREATEDB and CREATEROLE: each test gets a database named
# integral_sbx_<testid> owned by an unprivileged role of its own, so the
# sandboxed app never holds superuser (which would be a host compromise —
# COPY ... FROM PROGRAM, pg_read_file). Both are dropped at teardown.
#INTEGRAL_SANDBOX_PG_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Max concurrently running sandboxed apps (default 2).
#INTEGRAL_SANDBOX_MAX=2
# Idle teardown: kill the app + drop its DB after this long with no traffic.
#INTEGRAL_SANDBOX_IDLE_MS=900000
